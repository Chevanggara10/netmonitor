[Unit]
Description=Netmonitor web (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=netmonitor
WorkingDirectory=/opt/netmonitor
EnvironmentFile=/opt/netmonitor/.env
ExecStartPre=/opt/netmonitor/venv/bin/python -m alembic upgrade head
ExecStart=/opt/netmonitor/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
